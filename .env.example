# ShiftBridge Agent V2 — Groq-hosted AI (server-side only)
# Copy this file to .env and replace the placeholder with YOUR PRIVATE key.
AI_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=1
GROQ_TIMEOUT_MS=25000
SHIFTBRIDGE_API=http://127.0.0.1:3000/api

# Keep this disabled unless intentionally using the old CodeBuddy connector:
# AI_PROVIDER=tencent-local

# Supabase foundation (optional, trusted backend only; no browser secrets)
SUPABASE_URL=https://jpkobdggdsuinsquchxp.supabase.co
SUPABASE_SECRET_KEY=
# Deliberately blank unless explicitly approving a SQLite snapshot sync.
SUPABASE_SYNC_CONFIRM=
